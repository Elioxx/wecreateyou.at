RewriteEngine On

# Preserve signals from historical URLs that still appear in Google Search Console.
RewriteRule ^home/?$ / [R=301,L]
RewriteRule ^uberuns/?$ /#team [R=301,L,NE]
RewriteRule ^impressum/?$ /impressum.html [R=301,L]
RewriteRule ^landing/?$ / [R=301,L]
RewriteRule ^portfolio-5/?$ /referenzen.html [R=301,L]
RewriteRule ^referenzprojekte/?$ /referenzen.html [R=301,L]

# Baseline security headers. The CSP stays conservative because the current
# pages still contain a small number of intentional inline styles.
<IfModule mod_headers.c>
  <FilesMatch "\.(html?)$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Content-Security-Policy "upgrade-insecure-requests; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>
